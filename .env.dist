DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require&channel_binding=require
NEXT_PUBLIC_WHATSAPP_NUMBER=<E164-format-number-e.g.-33600000000>
REVALIDATE_TOKEN=<random-secret-token>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_PASSWORD=<choose-a-real-password-before-deploying>
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=<gemini-model-name-e.g.-gemini-3.6-flash>
GOOGLE_PLACES_API_KEY=<your-google-places-api-key>
SHOW_CONSTRUCTION_BANNER=true
# Neon Object Storage (Console → Connect → Storage, or `neon env pull`). Bucket: place-photos (public_read)
AWS_ENDPOINT_URL_S3=https://<branch-id>.storage.c-<N>.eu-central-1.aws.neon.tech
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=nak_live_...
AWS_SECRET_ACCESS_KEY=nsk_live_...
