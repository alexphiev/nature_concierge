datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

// ---------- Core corpus ----------

model Place {
  id                 String      @id @default(cuid())
  slug               String      @unique
  name               String
  commune            String
  departement        String
  lat                Float
  lng                Float
  type               String
  governingAuthority String?
  officialInfoUrl    String?
  description        String?
  demandRank         Int         @default(999)
  googlePlaceId      String?
  status             PlaceStatus @default(DRAFT)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Two levels max: a place (e.g. Calanque du Mugel) and its spots (e.g. Anse du Sec).
  parentId String?
  parent   Place?  @relation("PlaceHierarchy", fields: [parentId], references: [id])
  children Place[] @relation("PlaceHierarchy")

  claims          Claim[]             @relation("PlaceClaims")
  alternativeOf   Claim[]             @relation("AlternativePlace")
  statusSources   PlaceStatusSource[]
  ingestionDrafts IngestionDraft[]
  images          PlaceImage[]
  photos          PlacePhoto[]

  @@index([status, demandRank])
  @@index([parentId])
}

model PlaceImage {
  id      String @id @default(cuid())
  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  url    String
  source String?
  order  Int     @default(0)

  createdAt DateTime @default(now())

  @@index([placeId, order])
}

model PlacePhoto {
  id      String @id @default(cuid())
  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  key    String
  credit String?
  order  Int     @default(0)

  createdAt DateTime @default(now())

  @@index([placeId, order])
}

enum PlaceStatus {
  DRAFT
  ACTIVE
  RETIRED
}

model Claim {
  id      String @id @default(cuid())
  placeId String
  place   Place  @relation("PlaceClaims", fields: [placeId], references: [id])

  claimText          String
  claimType          ClaimType
  conditions         String[]
  audience           String[]
  verdict            Verdict
  alternativePlaceId String?
  alternativePlace   Place?    @relation("AlternativePlace", fields: [alternativePlaceId], references: [id])

  sourceId     String
  source       Source       @relation(fields: [sourceId], references: [id])
  verification Verification
  decayClass   DecayClass
  verifiedOn   DateTime
  isPublic     Boolean      @default(false)
  status       ClaimStatus  @default(DRAFT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  requestsUsedIn    RequestClaimUsed[]
  requestsCreatedBy RequestClaimCreated[]

  @@index([placeId, status])
}

enum ClaimType {
  ACCESS
  CROWDING
  SUITABILITY
  TIP
  AVOID
  ALTERNATIVE
  DECODING
  ACTIVITY
  PRACTICAL
  SAFETY
  NATURE
}

enum Verdict {
  GO
  GO_IF
  AVOID
  ALTERNATIVE
}

enum Verification {
  FIELD_VERIFIED
  OFFICIAL
  LOCAL_TESTIMONY
  HEURISTIC
}

enum DecayClass {
  PERMANENT
  SEASONAL
  ANNUAL_CHECK
}

enum ClaimStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

model Source {
  id              String           @id @default(cuid())
  type            String
  urlOrRef        String?
  dateCollected   DateTime
  reliability     Int              @default(2)
  notes           String?
  claims          Claim[]
  ingestionBlocks IngestionBlock[]
}

// ---------- Place status (written by the functions/placestatus scraper, plain SQL) ----------

model PlaceStatusSource {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placeId String  @map("place_id")
  place   Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)
  label   String?
  url     String
  enabled Boolean @default(true)
  config  Json    @default("{\"version\":1,\"rules\":[],\"ai\":{\"mode\":\"fallback\"}}")

  checkIntervalMinutes Int       @default(360) @map("check_interval_minutes")
  nextCheckAt          DateTime  @default(now()) @map("next_check_at") @db.Timestamptz
  leaseUntil           DateTime? @map("lease_until") @db.Timestamptz

  lastStatus          String    @default("unknown") @map("last_status")
  lastMethod          String?   @map("last_method")
  lastConfidence      Float?    @map("last_confidence") @db.Real
  lastEvidence        String?   @map("last_evidence")
  lastCheckedAt       DateTime? @map("last_checked_at") @db.Timestamptz
  lastChangedAt       DateTime? @map("last_changed_at") @db.Timestamptz
  lastContentHash     String?   @map("last_content_hash")
  lastEtag            String?   @map("last_etag")
  lastModified        String?   @map("last_modified")
  lastError           String?   @map("last_error")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  checks PlaceStatusCheck[]

  @@unique([placeId, url])
  @@index([placeId])
  @@map("place_status_source")
}

model PlaceStatusCheck {
  id           BigInt            @id @default(autoincrement())
  sourceId     String            @map("source_id") @db.Uuid
  source       PlaceStatusSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  invocationId String            @map("invocation_id")
  checkedAt    DateTime          @default(now()) @map("checked_at") @db.Timestamptz
  status       String
  method       String

  ruleIndex      Int?    @map("rule_index")
  confidence     Float?  @db.Real
  evidence       String?
  httpStatus     Int?    @map("http_status")
  contentHash    String? @map("content_hash")
  durationMs     Int?    @map("duration_ms")
  aiModel        String? @map("ai_model")
  aiInputTokens  Int?    @map("ai_input_tokens")
  aiOutputTokens Int?    @map("ai_output_tokens")
  error          String?

  @@unique([sourceId, invocationId])
  @@index([sourceId, checkedAt(sort: Desc)])
  @@map("place_status_check")
}

// ---------- Concierge log (the validation instrument) ----------

model Request {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  channel          Channel
  userRef          String
  requestText      String
  requestType      String?
  constraintsGiven String[]
  timeSpentMin     Int?
  outcome          Outcome  @default(ANSWERED)
  outcomeNotes     String?

  placesRecommended String[]
  claimsUsed        RequestClaimUsed[]
  claimsCreated     RequestClaimCreated[]
}

model RequestClaimUsed {
  requestId String
  claimId   String
  request   Request @relation(fields: [requestId], references: [id])
  claim     Claim   @relation(fields: [claimId], references: [id])

  @@id([requestId, claimId])
}

model RequestClaimCreated {
  requestId String
  claimId   String
  request   Request @relation(fields: [requestId], references: [id])
  claim     Claim   @relation(fields: [claimId], references: [id])

  @@id([requestId, claimId])
}

enum Channel {
  WHATSAPP
  FORM
  REDDIT
  FACEBOOK
  CAMPING_QR
  OTHER
}

enum Outcome {
  ANSWERED
  USER_WENT
  USER_REPORTED_BACK
  RETURNED_NEW_REQUEST
  REFERRED_SOMEONE
  SILENT
}

model IngestionDraft {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  placeId   String
  place     Place            @relation(fields: [placeId], references: [id])
  status    DraftStatus      @default(PENDING_REVIEW)
  blocks    IngestionBlock[]

  @@index([status, createdAt])
}

model IngestionBlock {
  id      String         @id @default(cuid())
  draftId String
  draft   IngestionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  order   Int

  inputSourceHint String?
  inputSourceType String?
  inputText       String?
  inputImages     Bytes[]
  transcript      String?

  rawModelOutput Json?
  draftSource    Json?
  draftClaims    Json
  sourceId       String?
  source         Source?     @relation(fields: [sourceId], references: [id])
  status         BlockStatus @default(PENDING_REVIEW)

  @@unique([draftId, order])
}

enum DraftStatus {
  PENDING_REVIEW
  ERROR
  APPROVED
  REJECTED
}

enum BlockStatus {
  PENDING_REVIEW
  ERROR
  RESOLVED
}

// ---------- Landing search ----------

model SearchShortcut {
  id      String  @id @default(cuid())
  label   String  @unique
  intro   String
  bgColor String
  fgColor String
  order   Int     @default(0)
  active  Boolean @default(true)
}
